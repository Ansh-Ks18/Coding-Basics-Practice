{
  "version": "2.0.0",
  "tasks": [
    {
      
      "label": "Compile and Run",
      "type": "shell",
      "command": "cmd",
      "args": [
        "/c",
        "g++ \"${file}\" -o \"${fileDirname}\\${fileBasenameNoExtension}\" && \"${fileDirname}\\${fileBasenameNoExtension}\" < input.txt > output.txt"
      ],
      "presentation": {
        "reveal": "never",
        "echo": true,
        "clear": true
      },
      "group": {
        "kind": "build",
        "isDefault": false
      },
      "problemMatcher": []
      
    }
    
  ]
}
